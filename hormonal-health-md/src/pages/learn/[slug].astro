---
import { render } from 'astro:content';
import ContentPage from '../../layouts/ContentPage.astro';
import Handoff from '../../components/Handoff.astro';
import { entries, paths } from '../../lib/content';

export async function getStaticPaths() {
  const all = await entries('learn');
  return all.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;
const path = paths.learn(entry.id);
const { Content, headings } = await render(entry);

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Answers', path: '/learn' },
  { name: d.question, path },
];
---

<ContentPage
  path={path}
  title={d.title}
  description={d.description}
  eyebrow={d.eyebrow}
  headline={d.headline}
  lede={d.lede}
  updated={d.updated}
  status={d.status}
  holdReason={d.holdReason}
  crumbs={crumbs}
  headings={headings}
  faqs={d.faqs}
  faqTitle="Related questions"
  sources={d.sources}
  ogType="article"
>
  <Content />

  <Handoff
    slot="after-prose"
    kicker="Where this leads"
    title={d.treatmentLabel}
    text="See who the treatment is for, what we test first, the options and how you are monitored."
    href={d.treatment}
    cta={`Read about ${d.treatmentLabel.toLowerCase()}`}
  />
</ContentPage>
