---
// The signature image: sunrise over the Atlantic, framed in an arch.
// Pure SVG, no photography, no network request.
interface Props {
  id?: string;
}
const { id = 'sr' } = Astro.props;

const reflections = Array.from({ length: 11 }, (_, i) => {
  const w = 168 - i * 11 + (i % 2 ? 14 : 0);
  return { y: 402 + i * 17, w, x: 240 - w / 2 + (i % 3 === 0 ? 6 : i % 3 === 1 ? -5 : 0), o: 0.62 - i * 0.05 };
});
const waves = [428, 462, 502, 546, 588].map((y, i) => {
  const step = 44 + i * 10;
  let d = `M-40 ${y}q${step / 2} -${5 + i} ${step} 0`;
  for (let x = -40 + step; x < 540; x += step) d += `t${step} 0`;
  return { d, o: 0.3 - i * 0.04 };
});
---

<svg class="sunrise" viewBox="0 0 480 600" role="img" aria-labelledby={`${id}-t`}>
  <title id={`${id}-t`}>Sunrise over the ocean off Hallandale Beach</title>
  <defs>
    <clipPath id={`${id}-arch`}>
      <path d="M0 600V240a240 240 0 0 1 480 0v360Z"></path>
    </clipPath>
    <linearGradient id={`${id}-sky`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#fdeedb"></stop>
      <stop offset=".5" stop-color="#fbcb9e"></stop>
      <stop offset="1" stop-color="#f4875a"></stop>
    </linearGradient>
    <radialGradient id={`${id}-glow`} cx="240" cy="380" r="270" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#fff7e0" stop-opacity=".95"></stop>
      <stop offset=".42" stop-color="#ffdca6" stop-opacity=".5"></stop>
      <stop offset="1" stop-color="#ffdca6" stop-opacity="0"></stop>
    </radialGradient>
    <linearGradient id={`${id}-sun`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#fffdf5"></stop>
      <stop offset="1" stop-color="#ffe2a8"></stop>
    </linearGradient>
    <linearGradient id={`${id}-sea`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#27786a"></stop>
      <stop offset=".35" stop-color="#17524a"></stop>
      <stop offset="1" stop-color="#0f2e29"></stop>
    </linearGradient>
  </defs>
  <g clip-path={`url(#${id}-arch)`}>
    <rect width="480" height="394" fill={`url(#${id}-sky)`}></rect>
    <rect width="480" height="394" fill={`url(#${id}-glow)`}></rect>
    <g stroke="#fff" stroke-linecap="round" opacity=".5">
      <path d="M52 236h96" stroke-width="5" opacity=".5"></path>
      <path d="M96 252h60" stroke-width="4" opacity=".35"></path>
      <path d="M318 196h110" stroke-width="5" opacity=".45"></path>
      <path d="M352 212h52" stroke-width="4" opacity=".3"></path>
    </g>
    <circle class="sunrise__sun" cx="240" cy="372" r="98" fill={`url(#${id}-sun)`}></circle>
    <rect y="392" width="480" height="208" fill={`url(#${id}-sea)`}></rect>
    <rect y="392" width="480" height="3" fill="#ffe2a8" opacity=".55"></rect>
    {
      reflections.map((r) => (
        <rect x={r.x} y={r.y} width={r.w} height="5" rx="2.5" fill="#ffd9a0" opacity={r.o} />
      ))
    }
    <g class="sunrise__waves" fill="none" stroke="#cde4da" stroke-width="1.5" stroke-linecap="round">
      {waves.map((w) => <path d={w.d} opacity={w.o} />)}
    </g>
  </g>
</svg>

<style>
  .sunrise {
    width: 100%;
    height: auto;
    border-radius: 0 0 var(--r-lg) var(--r-lg);
    filter: drop-shadow(0 40px 60px rgb(15 46 41 / 0.28));
  }
  .sunrise__waves {
    animation: drift 14s ease-in-out infinite alternate;
  }
  @keyframes drift {
    to {
      transform: translateX(-28px);
    }
  }
</style>
