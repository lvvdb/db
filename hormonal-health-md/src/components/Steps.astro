---
// "How care works": the four steps every patient goes through.
interface Props {
  eyebrow?: string;
  title?: string;
  text?: string;
  steps?: { title: string; text: string }[];
}
const {
  eyebrow = 'How care works',
  title = 'Four steps, <em>no guesswork.</em>',
  text = 'Symptoms tell us where to look. Labs tell us what is true. You get both, explained in plain English.',
  steps = [
    { title: 'Tell us what is going on', text: 'Take the two-minute assessment or call. Nothing you answer is stored or sent anywhere.' },
    { title: 'Get your labs drawn', text: 'We order the panel that fits your symptoms and history, so the plan starts from facts.' },
    { title: 'Review every number', text: 'A licensed clinician walks you through your results and builds the plan with you. Treatment is prescribed only when it is clinically right.' },
    { title: 'Follow up and adjust', text: 'Repeat labs and check-ins on a schedule. Your dose follows your results, never a template.' },
  ],
} = Astro.props;
---

<section class="section section--ink">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">{eyebrow}</p>
      <h2 set:html={title} />
      <p>{text}</p>
    </div>
    <ol class="steps">
      {
        steps.map((s, i) => (
          <li>
            <span class="steps__n">{String(i + 1).padStart(2, '0')}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .steps {
    display: grid;
    gap: 1.5rem;
    list-style: none;
  }
  @media (min-width: 40rem) {
    .steps {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 68rem) {
    .steps {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .steps li {
    padding: 1.6rem 1.5rem 1.7rem;
    border: 1px solid var(--line-light);
    border-radius: var(--r-lg);
    background: rgb(251 248 242 / 0.05);
  }
  .steps__n {
    display: block;
    margin-bottom: 2.25rem;
    color: var(--sun-2);
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-style: italic;
    line-height: 1;
  }
  .steps h3 {
    margin-bottom: 0.6rem;
    font-size: var(--step-1);
  }
  .steps p {
    color: rgb(251 248 242 / 0.72);
    font-size: 0.97rem;
    line-height: 1.55;
  }
</style>
