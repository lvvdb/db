{
  "name": "hormonal-health-md",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Static, SEO-first website for Hormonal Health MD (Hallandale Beach, FL).",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/gen-redirects.mjs",
    "build": "astro build",
    "build:drafts": "node scripts/gen-redirects.mjs && SHOW_DRAFTS=1 astro build --outDir dist-drafts",
    "preview": "node scripts/serve.mjs dist 4321",
    "preview:drafts": "node scripts/serve.mjs dist-drafts 4322",
    "qa": "node scripts/qa.mjs",
    "check": "npm run build && npm run qa",
    "check:launch": "npm run build && node scripts/qa.mjs --launch",
    "check:sources": "node scripts/check-sources.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.7",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "astro": "^7.4.8"
  }
}
